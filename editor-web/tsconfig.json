{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "paths": {
      "@10play/tentap-editor": ["../node_modules/@10play/tentap-editor/lib-web/typescript/webEditorUtils/index.d.ts"],
      "@/*": ["../src/*"]
    },
    "moduleResolution": "bundler",
    "target": "es2017",
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src/editor/markdownBridge.ts", "../src/editor/mediaBridge.ts"]
}
