{
  "expo": {
    "name": "VB Notes",
    "slug": "vbnotes",
    "owner": "ramarya",
    "scheme": "vbnotes",
    "version": "0.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/90bb17f8-842e-4445-a3e1-eecdb79c1b76",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#17181C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lavneet.vbnotes",
      "infoPlist": {
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "J9YMW2253U"
    },
    "android": {
      "package": "com.lavneet.vbnotes",
      "adaptiveIcon": {
        "backgroundColor": "#17181C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "plugins": [
      "./plugins/withIphoneOnlyExtensions",
      "./plugins/withGradleMemory",
      "expo-router",
      "expo-font",
      [
        "expo-file-system",
        {
          "enableFileSharing": true,
          "supportsOpeningDocumentsInPlace": true
        }
      ],
      "react-native-blob-util",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0",
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true,
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.ReactNativeBlobUtil.** { *; }"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VB Notes adds the photos you pick to your notes.",
          "cameraPermission": "VB Notes adds the photos you take to your notes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "VB Notes records voice notes into your notes."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 10
          },
          "iosShareExtensionName": "Save to VB Notes",
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ]
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "90bb17f8-842e-4445-a3e1-eecdb79c1b76"
      }
    }
  }
}
